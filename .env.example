# ==============================================================================
# ParcelEase Environment Variables Configuration
# ==============================================================================

# Application Environment & Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Credentials
# Find these in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo & Mock Mode Toggle
# When true, ParcelEase runs with a self-contained in-memory + local storage simulated database
# containing Greenwood Heights RWA sample dataset, allowing zero-friction testing without Supabase credentials.
NEXT_PUBLIC_DEMO_MODE=true

# Notification Integrations (Optional Extensibility)
# In-app notifications are active by default. Configure below when connecting external SMS/WhatsApp/Email providers.
SMS_GATEWAY_PROVIDER=mock # options: mock, twilio, gupshup, kaleyra
SMS_GATEWAY_API_KEY=
WHATSAPP_BUSINESS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=parcels@parcelease.in
